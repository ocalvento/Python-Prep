{
  "name": "linkedin-news-automation",
  "version": "1.0.0",
  "description": "Automatización de publicaciones en LinkedIn desde un feed de noticias",
  "main": "dist/jobs/publish.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/jobs/publish.ts",
    "dry-run": "DRY_RUN=true ts-node src/jobs/dryRun.ts",
    "publish-now": "ts-node src/jobs/publish.ts",
    "schedule": "ts-node src/jobs/scheduler.ts",
    "get-token": "ts-node scripts/getToken.ts",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "axios": "^1.7.2",
    "axios-retry": "^4.4.0",
    "better-sqlite3": "^9.6.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.ts"],
    "collectCoverageFrom": ["src/**/*.ts"]
  }
}
