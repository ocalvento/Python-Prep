# ─── LinkedIn OAuth 2.0 ──────────────────────────────────────────────────────
# Obtener en: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback

# Tokens (se gestionan automáticamente después de la autenticación inicial)
# Ejecutá `npm run get-token` para obtenerlos la primera vez.
# En CI/CD podés setear LINKEDIN_ACCESS_TOKEN directamente.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=

# ─── Control editorial ────────────────────────────────────────────────────────
# Umbral mínimo de relevancia para publicar (0-100)
SCORE_THRESHOLD=75

# Si es true, el job guarda los posts como "pending_approval" en lugar de publicarlos.
# Revisás manualmente y luego corrés: npm run publish-approved
APPROVAL_REQUIRED=false

# Modo dry-run: si es true, simula el pipeline completo sin publicar ni escribir en DB
DRY_RUN=false

# Máximo de posts que se publican en una sola corrida (rate limiting defensivo)
MAX_POSTS_PER_RUN=3

# Ignorar noticias más antiguas que N días
MAX_NEWS_AGE_DAYS=30

# ─── Scoring (pesos, deben sumar ~100) ───────────────────────────────────────
SCORE_WEIGHT_RECENCY=30
SCORE_WEIGHT_TAGS=30
SCORE_WEIGHT_SOURCE=20
SCORE_WEIGHT_LENGTH=10
SCORE_WEIGHT_BONUS=5
# Máximo de puntos de penalización por contenido genérico/corto
SCORE_PENALTY_MAX_POINTS=15

# ─── Copy ────────────────────────────────────────────────────────────────────
# Límite de caracteres del post (máximo LinkedIn: 3000)
MAX_POST_CHARS=3000
# Máximo de hashtags
MAX_HASHTAGS=4
# Mínimo de caracteres del copy para no rechazarlo por calidad
COPY_MIN_CHARS=200
# Coeficiente de Jaccard máximo permitido entre el nuevo post y los recientes (0-1)
# 0.55 = rechazar si más del 55% de bigramas se repiten
COPY_PHRASE_OVERLAP_THRESHOLD=0.55
# Cuántos posts recientes revisar para detectar overlap
RECENT_POSTS_TO_CHECK=10

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=./data/linkedin_automation.db
# Cuántos minutos antes de considerar un lock de ejecución como stale (proceso caído)
LOCK_MAX_AGE_MINUTES=30

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Expresión cron (default: 9 AM todos los días)
CRON_SCHEDULE=0 9 * * *

# ─── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
