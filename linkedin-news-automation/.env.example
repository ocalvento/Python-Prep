# ─── LinkedIn OAuth 2.0 ──────────────────────────────────────────────────────
# Obtener en: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback
# Tokens (gestionados automáticamente después de npm run get-token)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=

# ─── BOIA — fuente de datos ───────────────────────────────────────────────────
# Tipo de fuente: json | api | db
BOIA_SOURCE=json

# Opción A — archivo JSON exportado por BOIA (default, MVP)
BOIA_JSON_PATH=./inputs/boia_candidates.json

# Opción B — endpoint API interno de BOIA
# BOIA_API_URL=http://localhost:4000
# BOIA_API_KEY=your_boia_api_key
# BOIA_API_LIMIT=50

# Opción C — base de datos SQLite de BOIA
# BOIA_DB_PATH=../boia/data/boia.db
# BOIA_DB_TABLE=candidates

# ─── Filtros de publicación ───────────────────────────────────────────────────
# Score mínimo asignado por BOIA (0-100). BOIA es la fuente de verdad regulatoria.
BOIA_MIN_RELEVANCE=70

# Score editorial mínimo calculado por el sistema LinkedIn (0-100)
LINKEDIN_MIN_SCORE=60

# Máximo de posts del mismo organismo por corrida
# El segundo ítem del mismo organismo solo se publica si linkedin_score >= LINKEDIN_EXCEPTIONAL_SCORE
LINKEDIN_SAME_ORGANISM_MAX=1
LINKEDIN_EXCEPTIONAL_SCORE=90

# ─── Control operativo ────────────────────────────────────────────────────────
# Simula sin publicar ni escribir en DB
DRY_RUN=false

# Si true: genera posts pero los guarda como "pending_approval" (no publica)
# Revisás manualmente y luego corrés: npm run publish-approved
APPROVAL_REQUIRED=false

# Máximo de posts publicados en una sola corrida (rate limiting defensivo)
MAX_POSTS_PER_RUN=3

# Ignorar candidatos más antiguos que N días
MAX_NEWS_AGE_DAYS=30

# ─── Scoring editorial ────────────────────────────────────────────────────────
# Máximo de puntos de penalización por tecnicismo excesivo
SCORE_PENALTY_MAX_POINTS=15

# ─── Copy ────────────────────────────────────────────────────────────────────
MAX_POST_CHARS=3000
MAX_HASHTAGS=4
COPY_MIN_CHARS=200
# Coeficiente de Jaccard máximo permitido con posts recientes (0-1)
COPY_PHRASE_OVERLAP_THRESHOLD=0.55
RECENT_POSTS_TO_CHECK=10

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=./data/linkedin_automation.db
LOCK_MAX_AGE_MINUTES=30

# ─── Scheduler ───────────────────────────────────────────────────────────────
CRON_SCHEDULE=0 9 * * *

# ─── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
