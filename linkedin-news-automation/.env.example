# ─── LinkedIn OAuth 2.0 ──────────────────────────────────────────────────────
# Obtener en: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# URL de redirección configurada en tu app de LinkedIn
# Para desarrollo local usar: http://localhost:3000/callback
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback

# Tokens (se gestionan automáticamente después de la autenticación inicial)
# Ejecutá `npm run get-token` para obtenerlos la primera vez
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_REFRESH_TOKEN=

# ─── App ─────────────────────────────────────────────────────────────────────
# Umbral mínimo de relevancia para publicar (0-100)
SCORE_THRESHOLD=75

# Modo dry-run: si es true, no publica en LinkedIn
DRY_RUN=false

# Ruta al archivo de noticias de entrada
NEWS_INPUT_PATH=./inputs/news.json

# ─── Base de datos ────────────────────────────────────────────────────────────
DB_PATH=./data/linkedin_automation.db

# ─── Scheduler ───────────────────────────────────────────────────────────────
# Expresión cron para el schedule automático (default: 9 AM todos los días)
CRON_SCHEDULE=0 9 * * *

# ─── Logs ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_DIR=./logs
