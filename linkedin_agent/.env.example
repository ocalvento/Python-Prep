# Anthropic API key — get from https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LinkedIn OAuth2 access token with w_member_social scope
# Get via LinkedIn Developer Portal: https://www.linkedin.com/developers/
LINKEDIN_ACCESS_TOKEN=your_linkedin_access_token_here

# Your LinkedIn member URN (the numeric ID from your profile URL)
# e.g., if your profile is linkedin.com/in/johndoe and your member ID is 123456789
LINKEDIN_PERSON_URN=123456789

# Comma-separated list of topics Claude will pick from randomly
POST_TOPICS=Python programming,Software engineering best practices,Career growth in tech,AI and machine learning trends

# Posting schedule (UTC time)
# Days: mon, tue, wed, thu, fri, sat, sun (comma-separated)
SCHEDULE_DAYS=mon,wed,fri
SCHEDULE_HOUR=9
SCHEDULE_MINUTE=0

# Maximum LinkedIn post length (LinkedIn limit is 3000, recommended ~1300)
MAX_POST_LENGTH=1300
